---
---

<main class="event-page">
  <div class="event-content">
    <h1>
      Design with
      <br />
      Readymag
    </h1>

    <div class="event-info">
      <div class="info-item">
        <span class="info-label">20/12-2026</span>
      </div>

      <div class="info-item">
        <span class="info-label">Copenhagen</span>
      </div>

      <div class="info-item">
        <span class="info-label">Network</span>
      </div>
    </div>

    <a href="#" class="ticket-button">
      Tickets
    </a>

    <img class="event-image" src="../img/eventimg.webp" alt="People attending a creative design event" />

    <section class="expect-section">
      <h2>What can you expect?</h2>

      <p>Join us for an inspiring event where creativity and design come together. Meet like-minded people, share ideas and connect with other creatives in Copenhagen.</p>
    </section>
  </div>
</main>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  .event-page {
    width: 100%;
    min-height: 100vh;
    margin: 0;
  }
  * {
    box-sizing: border-box;
  }

  .event-page {
    background-color: #34352e;
    color: #ffffff;
    min-height: 100vh;
    padding: 55px 8%;
    font-family: inherit;
  }

  .event-content {
    max-width: 900px;
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 800;
    line-height: 1.12;
    margin: 0 0 42px;
  }

  .event-info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 42px;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .emoji {
    font-size: 28px;
    line-height: 1;
  }

  .info-label {
    background-color: #d75a27;
    color: white;
    font-size: 19px;
    font-weight: 700;
    text-align: center;
    padding: 4px 16px;
    min-width: 160px;
    border-radius: 3px;
  }

  .ticket-button {
    display: inline-block;
    background-color: #d75a27;
    color: white;
    text-decoration: none;
    font-size: 30px;
    font-weight: 700;
    padding: 10px 48px;
    border-radius: 3px;
    margin-bottom: 55px;
    transition: background-color 0.2s ease;
  }

  .ticket-button:hover {
    background-color: #b9471d;
  }

  .event-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.5 / 1;
    object-fit: cover;
    margin-bottom: 22px;
  }

  .expect-section h2 {
    font-size: 30px;
    font-weight: 700;
    margin: 0 0 24px;
  }

  .expect-section p {
    font-size: 18px;
    line-height: 1.7;
    max-width: 650px;
    margin: 0;
  }

  @media (max-width: 600px) {
    .event-page {
      padding: 35px 6%;
    }

    h1 {
      font-size: 2.7rem;
      margin-bottom: 30px;
    }

    .event-info {
      gap: 15px;
      margin-bottom: 30px;
    }

    .info-item {
      width: 100%;
      gap: 12px;
    }

    .info-label {
      flex: 1;
      min-width: 0;
      font-size: 17px;
      padding: 5px 12px;
    }

    .emoji {
      font-size: 25px;
    }

    .ticket-button {
      font-size: 25px;
      padding: 10px 35px;
      margin-bottom: 35px;
    }

    .event-image {
      aspect-ratio: 1 / 1;
      margin-bottom: 20px;
    }

    .expect-section h2 {
      font-size: 25px;
    }

    .expect-section p {
      font-size: 16px;
    }
  }
</style>
