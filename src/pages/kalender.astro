---
import Layout from '../layouts/Layout.astro';
const endpoint = 'https://zlesvdpxihvncfatrbrv.supabase.co/rest/v1/events?select=*' ;
//const apikey = "sb_publishable_UaSkE1Bp88zpKvvigYgX3w_t35DG95l";

const options = {
    headers: {
        apikey: "sb_publishable_UaSkE1Bp88zpKvvigYgX3w_t35DG95l"
    },
}
const data = await fetch(endpoint, options).then((res) => res.json());
console.log(data);
---

<Layout>
  <h1>Events</h1>
  <ul>
    {data.map((event) => (
      <li key={event.id}>
        <h2>{event.title}</h2>
        <p>{event.description}</p>
        <p>Date: {event.date}</p>
      </li>
    ))}
  </ul>
</Layout>