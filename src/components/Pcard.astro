components: ---
const {product} = Astro.props;
---

<article>
    <img src=`https://kea-alt-del.dk/t7/images/webp/640/${product.id}.webp`
     alt="productbillede" />
    <h2>{product.productdisplayname} </h2>
    <p>{product.price},- kr.</p>
</article>

    <style>
        article {
            padding: 1rem;
            border: 1px solid;
            background-color: #ef9191;
        }
        img {
            max-width: 100%;
        }
    </style>